{
  "name": "customer-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/customer-service/src",
  "tags": ["type:app", "scope:customer"],
  "targets": {
    "typecheck": {},
    "lint": {},
    "test": {},
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig apps/customer-service/tsconfig.json --env-file-if-exists=apps/customer-service/.env apps/customer-service/src/main.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/customer-service"],
      "options": { "command": "node tools/build-app.mjs customer-service" }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig apps/customer-service/tsconfig.json --env-file-if-exists=apps/customer-service/.env apps/customer-service/src/migrate.ts"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "drizzle-kit generate --config apps/customer-service/src/db/drizzle.config.ts" }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": { "command": "docker build -f apps/customer-service/Dockerfile -t mono-one/customer-service:latest ." }
    }
  }
}
