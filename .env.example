# Dev config for every app (`pnpm env:init` copies this to .env). Read by `pnpm dev`, `dev:migrate`, `dev:seed`.
# Containers set their own env (docker-compose.yml). Commented lines show the default.

# --- all apps ---
# NODE_ENV=development             # development | test | production (pretty logs in development; the seed refuses production)
LOG_LEVEL=debug                    # fatal | error | warn | info | debug | trace | silent (default info)
# REQUEST_TIMEOUT_MS=5000          # service-to-service call timeout
# EVENT_TIMEOUT_MS=2500            # event delivery timeout
# WEB_URL=http://localhost:3000
# CUSTOMER_SERVICE_URL=http://localhost:3001
# ORDER_SERVICE_URL=http://localhost:3002
# DOCUMENT_SERVICE_URL=http://localhost:3003
# SYSTEM_SERVICE_URL=http://localhost:3004
# APP_VERSION=                     # shown in logs

# --- per app: keep unset here, this file is shared by all apps ---
# PORT=                            # default per app: web 3000, customer 3001, order 3002, document 3003, system 3004
# SERVICE_ID=                      # default: the app's own id

# --- services with a database (customer, order, system) ---
# DATABASE_URL_<SERVICE_ID> is resolved per service; an explicit DATABASE_URL (containers) wins over it.
DATABASE_URL_CUSTOMER_SERVICE=postgres://postgres:pg@localhost:5432/mono_customer
DATABASE_URL_ORDER_SERVICE=postgres://postgres:pg@localhost:5432/mono_order
DATABASE_URL_SYSTEM_SERVICE=postgres://postgres:pg@localhost:5432/mono_system
# DB_SCHEMA=public
# DB_POOL_SIZE=10
# DB_SLOW_QUERY_MS=500             # slower queries are logged as warnings
# DB_CONNECTION_TIMEOUT_MS=2000    # wait for a free pool connection before failing
# DB_IDLE_TIMEOUT_MS=30000         # idle pool connections are closed after this
# DB_STATEMENT_TIMEOUT_MS=10000    # Postgres cancels longer statements
# MIGRATIONS_DIR=                  # migration runner in images only; default apps/<svc>/src/db/migrations

# --- web ---
REDIS_URL=redis://localhost:6379
# JWT_TTL_SECONDS=3600
