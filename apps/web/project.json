{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"tags": ["type:app", "scope:web"],
	"targets": {
		"typecheck": {
			"executor": "nx:run-commands",
			"options": { "command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json", "cwd": "apps/web" }
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node --env-file-if-exists=.env ../../node_modules/vite/bin/vite.js dev",
				"cwd": "apps/web"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/apps/web"],
			"options": { "command": "vite build", "cwd": "apps/web" }
		},
		"docker-build": {
			"executor": "nx:run-commands",
			"options": { "command": "docker build -f apps/web/Dockerfile -t mono-one/web:latest ." }
		}
	}
}
