{
  "name": "mono-one",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NX_NATIVE_COMMAND_RUNNER=false nx run-many -t serve --parallel=4 --output-style=stream",
    "env:init": "[ -e .env ] || cp .env.example .env",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:migrate": "nx run-many -t dev:migrate --parallel=4 --output-style=static",
    "dev:seed": "nx run-many -t dev:seed --parallel=4 --output-style=static",
    "graph": "nx graph",
    "lint": "nx run-many -t lint -- --fix && eslint --fix libs/*.ts libs/trpc libs/migrations",
    "lint:libs": "eslint libs/*.ts libs/trpc libs/migrations",
    "lint:check": "nx run-many -t lint && pnpm lint:libs",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "typecheck": "nx run-many -t typecheck",
    "test": "NX_NATIVE_COMMAND_RUNNER=false nx run-many -t test --output-style=stream",
    "test:force": "NX_NATIVE_COMMAND_RUNNER=false nx run-many -t test --output-style=stream --skip-nx-cache",
    "build": "nx run-many -t build",
    "build:images": "NX_NATIVE_COMMAND_RUNNER=false nx run-many -t docker-build --output-style=stream",
    "all": "pnpm format && pnpm lint && NX_NATIVE_COMMAND_RUNNER=false nx run-many -t typecheck test build --output-style=stream"
  },
  "dependencies": {
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "awilix": "13.0.5",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/esbuild": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "flowbite": "4.0.2",
    "flowbite-svelte": "2.0.0-next.14",
    "flowbite-svelte-icons": "3.1.0",
    "globals": "17.13.0",
    "nx": "23.3.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svstate": "2.1.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
