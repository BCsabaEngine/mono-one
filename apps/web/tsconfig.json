{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@lib/*": ["../../libs/*"],
			"@api/*": ["../../libs/*-api/src/index.ts"],
			"@domain/*": ["../../libs/*-api/src/domain.ts"],
			"@events/*": ["../../libs/events/src/*.ts"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
