{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/src/seed.ts",
      "!{projectRoot}/src/db/seed.ts",
      "!{projectRoot}/Dockerfile",
      "!{projectRoot}/.env.example",
      "!{projectRoot}/**/*.md",
      "!{workspaceRoot}/libs/testing.ts",
      "!{workspaceRoot}/libs/seeding.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/libs/*.ts",
      "{workspaceRoot}/libs/trpc/**/*",
      "{workspaceRoot}/libs/migrations/**/*"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      },
      "exclude": ["apps/web/**"]
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json"
      },
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "test": {
      "options": {
        "command": "vitest run"
      }
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "{projectRoot}/src/main.ts",
        "additionalEntryPoints": ["{projectRoot}/src/migrate.ts"],
        "outputPath": "dist/{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.json",
        "platform": "node",
        "target": "node24",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "sourcemap": false,
        "skipTypeCheck": true,
        "external": ["pg-native"],
        "assets": [
          {
            "input": "{projectRoot}/src/db/migrations",
            "glob": "**/*",
            "output": "migrations"
          }
        ],
        "esbuildOptions": {
          "outExtension": {
            ".js": ".mjs"
          },
          "banner": {
            "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
          }
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx watch --tsconfig {projectRoot}/tsconfig.json --env-file-if-exists={projectRoot}/.env {projectRoot}/src/main.ts"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker build -f {projectRoot}/Dockerfile -t mono-one/{projectName}:latest ."
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig {projectRoot}/tsconfig.json --env-file-if-exists={projectRoot}/.env {projectRoot}/src/seed.ts"
      }
    },
    "dev:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit push --config {projectRoot}/src/db/drizzle.config.ts",
        "envFile": "{projectRoot}/.env"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate --config {projectRoot}/src/db/drizzle.config.ts"
      }
    }
  },
  "defaultBase": "main",
  "analytics": false
}
