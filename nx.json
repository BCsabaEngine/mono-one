{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.test.ts"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/libs/*.ts",
      "{workspaceRoot}/libs/trpc/**/*",
      "{workspaceRoot}/libs/migrations/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json"
      },
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint {projectRoot}"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root {projectRoot} --passWithNoTests"
      },
      "inputs": ["default", "^production"],
      "cache": true
    },
    "@nx/esbuild:esbuild": {
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "{projectRoot}/src/main.ts",
        "additionalEntryPoints": ["{projectRoot}/src/migrate.ts"],
        "outputPath": "dist/{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.json",
        "platform": "node",
        "target": "node24",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "sourcemap": true,
        "skipTypeCheck": true,
        "external": ["pg-native", "pino-pretty"],
        "assets": [{ "input": "{projectRoot}/src/db/migrations", "glob": "**/*", "output": "migrations" }],
        "esbuildOptions": {
          "outExtension": { ".js": ".mjs" },
          "banner": {
            "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
          }
        }
      }
    },
    "serve": {
      "continuous": true
    },
    "docker-build": {
      "dependsOn": ["build"]
    }
  },
  "defaultBase": "main",
  "analytics": false
}
